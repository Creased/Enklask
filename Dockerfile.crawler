# Minimal, multi-arch image to run the Leboncoin crawler on a headless host
# (e.g. an isolated Raspberry Pi). NO browser needed: the crawler uses curl_cffi
# (browser TLS/JA3 impersonation) to SELF-MINT a DataDome cookie against the web
# /finder/search endpoint -- fully unattended, no cookie copying. The only
# requirement is a reasonably trusted egress IP (a French home-broadband Pi is
# usually fine); if your IP is blocked, pass a French residential/mobile proxy
# via LBC_PROXY.
#
# python:slim is multi-arch (amd64/arm64/armv7) and curl_cffi ships prebuilt
# aarch64 manylinux wheels (+ armv7 on piwheels), so this builds with no
# compiler or browser layers on a Pi. ca-certificates for TLS to leboncoin.
FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && pip install --no-cache-dir curl_cffi httpx==0.28.1

COPY scripts/lbc_crawl.py /app/lbc_crawl.py

# Cache the harvested-cookie state file here; mount a volume to persist it.
RUN mkdir -p /app/data
VOLUME ["/app/data"]

# One-shot CLI: pass the query and flags as `docker run` arguments.
ENTRYPOINT ["python", "/app/lbc_crawl.py"]
CMD ["--help"]
