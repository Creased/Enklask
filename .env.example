# ---------------------------------------------------------------------------
# Ad Tracker configuration. Copy to `.env` and fill in what you need.
# Every source can be toggled independently; the app stays useful even if
# only eBay is configured.
# ---------------------------------------------------------------------------

# Where the SQLite database lives (a single file).
DATABASE_URL=sqlite:///data/ad_tracker.db

# How often (minutes) the scheduler polls all enabled sources.
POLL_INTERVAL_MINUTES=10

# Your home point, used to compute distance to each ad (default: Rennes).
HOME_LAT=48.1173
HOME_LON=-1.6778

# --- Sources: enable/disable each one ---------------------------------------
ENABLE_EBAY=true
ENABLE_VINTED=false
ENABLE_LEBONCOIN=false
ENABLE_FACEBOOK=false
ENABLE_RAKUTEN=false
ENABLE_GEEV=false

# --- eBay (official Browse API) ---------------------------------------------
# Create a free developer account at https://developer.ebay.com/ and make a
# "production" keyset. Paste the App ID (Client ID) and Cert ID (Client Secret).
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_MARKETPLACE_ID=EBAY_FR

# --- Vinted (unofficial internal API; no credentials needed) ----------------
VINTED_BASE_URL=https://www.vinted.fr

# --- Leboncoin (unofficial; DataDome-protected, best effort) ----------------
LEBONCOIN_BASE_URL=https://api.leboncoin.fr

# --- Facebook Marketplace ---------------------------------------------------
# No account needed: reads the public Marketplace GraphQL feed via browser-TLS
# (curl_cffi), searching around HOME_LAT/HOME_LON. Just toggle ENABLE_FACEBOOK.

# --- Rakuten France (unofficial; reads public search via JSON-LD) -----------
RAKUTEN_BASE_URL=https://fr.shopping.rakuten.com

# --- Geev (unofficial internal API; free/cheap donor units near you) --------
GEEV_BASE_URL=https://prod.geev.fr
GEEV_WEB_BASE=https://www.geev.com
# Optional bearer token if the endpoint requires auth (capture from the app).
GEEV_API_KEY=
# Search radius in km around HOME_LAT/HOME_LON.
GEEV_RADIUS_KM=50

# --- Notifications (Apprise) ------------------------------------------------
# One or more Apprise URLs (comma or space separated). Leave empty to disable.
# Examples:
#   ntfy:     ntfy://ntfy.sh/mon-sujet-switch
#   Telegram: tgram://<bot_token>/<chat_id>
#   Discord:  discord://<webhook_id>/<webhook_token>
#   Email:    mailto://user:pass@gmail.com
# Full list: https://github.com/caronc/apprise/wiki
APPRISE_URLS=
# Notify on the very first (seeding) poll? Usually no, to avoid a flood.
NOTIFY_ON_FIRST_RUN=false
# Above this many new ads in one poll, send a single digest instead of N pushes.
NOTIFY_MAX_PER_POLL=15
